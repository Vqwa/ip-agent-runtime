# InsightfulPipe Hosted Agents — runtime image (the Hermes fork).
# One turn per request; code-exec offloaded to E2B; secrets via stdin per turn.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    HERMES_DISABLE_LAZY_INSTALLS=1 \
    TERMINAL_ENV=e2b

WORKDIR /app

# ca-certificates for TLS; libffi for cffi (pyjwt[crypto] transitive).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Source (TS/desktop/docs/tests excluded via .dockerignore).
COPY . /app

# H013 supply chain: every third-party dep is hash-pinned (requirements.lock,
# regenerate with `uv pip compile pyproject.toml requirements-runtime-extras.in
# --generate-hashes -o requirements.lock`). --require-hashes refuses any artifact
# whose download hash doesn't match — a compromised mirror serving a tampered wheel
# fails the build. The local package installs --no-deps (deps already locked above).
RUN pip install --no-cache-dir --timeout 120 --retries 10 --require-hashes -r requirements.lock \
    && pip install --no-cache-dir --timeout 120 --retries 10 --no-deps --no-build-isolation -e .

# Bake a models.dev snapshot so capability lookups (supports_vision) work offline;
# turn_worker seeds each ephemeral HERMES_HOME from it. Build fails if unfetchable.
RUN python -c "import requests, pathlib; r = requests.get('https://models.dev/api.json', timeout=60); r.raise_for_status(); pathlib.Path('/app/models_dev_snapshot.json').write_bytes(r.content)"

# Non-root.
RUN useradd -m -u 10001 runtime && chown -R runtime:runtime /app
USER runtime

# Provided at deploy (NOT baked secrets): RUNTIME_JWT_PUBLIC_KEY (public, fine),
# E2B_API_KEY, E2B_TEMPLATE. Tenant secrets arrive per-turn via stdin only.
# Cloud Run: internal ingress + IAM (Django SA is the only invoker).
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
